+        const size_t s = seq[i]._Find_first();
+        return s < LLAMA_MAX_SEQ ? (llama_seq_id) s : -1;
+#else
         for (int s = 0; s < LLAMA_MAX_SEQ; ++s) {
             if (seq[i].test(s)) {
                 return s;
@@ -350,6 +377,7 @@ public:
         }
 
         return -1;
+#endif
     }
 
