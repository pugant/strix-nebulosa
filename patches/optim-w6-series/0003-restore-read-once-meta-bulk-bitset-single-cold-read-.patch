+    // a single-sequence cell no longer pays 256 bit tests per operation
     void seq_pos_rm(uint32_t i) {
-        for (int s = 0; s < LLAMA_MAX_SEQ; ++s) {
-            if (seq[i].test(s)) {
-                seq_pos_dec(s, pos[i]);
-            }
-        }
+        llama_kv_cells_seq_foreach(seq[i], [&](llama_seq_id s) {
+            seq_pos_dec(s, pos[i]);
+        });
     }
 
     // add cell i
