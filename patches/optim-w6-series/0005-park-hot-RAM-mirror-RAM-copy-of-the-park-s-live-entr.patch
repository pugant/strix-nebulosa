+    std::error_code rm_ec;
+    fs::remove_all(fs::u8path(base), rm_ec);
+
+    if (g_failures == 0) {
+        printf("test-park-mirror: ALL PASS\n");
+        return 0;
+    }
+    printf("test-park-mirror: %d FAILURES\n", g_failures);
+    return 1;
