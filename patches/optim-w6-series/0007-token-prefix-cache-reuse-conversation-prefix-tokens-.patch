+    static size_t common_prefix_len(const std::string & a, const std::string & b) {
+        const size_t n = std::min(a.size(), b.size());
+        size_t i = 0;
+        for (; i + 64 <= n; i += 64) {
+            if (memcmp(a.data() + i, b.data() + i, 64) != 0) {
