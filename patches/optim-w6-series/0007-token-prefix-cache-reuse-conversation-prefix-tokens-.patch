+    static int32_t piece_length(const llama_vocab * vocab, llama_token tok, char * buf, size_t buf_size) {
+        return llama_token_to_piece(vocab, tok, buf, (int32_t) buf_size, /*lstrip*/ 0, /*special*/ true);
+    }
