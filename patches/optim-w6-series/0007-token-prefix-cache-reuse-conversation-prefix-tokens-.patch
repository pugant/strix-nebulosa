+    std::vector<uint32_t> tok_end;
+    // token index / byte start / piece length of every special-attr token, in token order
+    struct special_mark {
+        uint32_t index;
+        uint32_t start;
+        uint32_t length;
+    };
+    std::vector<special_mark> specials;
