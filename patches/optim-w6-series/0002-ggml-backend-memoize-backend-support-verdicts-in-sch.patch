 ggml/src/ggml-backend.cpp | 292 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 285 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 4e36909f4..8805910dd 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -761,6 +761,70 @@ static bool ggml_is_view_op(enum ggml_op op) {
 #define GGML_SCHED_MAX_COPIES 4
 #endif
 
+// A5-C3 (W6-9, first step): memoization of backend-support verdicts used by the
+// graph-splitting assignment passes.
+//
+// ggml_backend_sched_split_graph() re-derives the same supports_op()/supports_buft()
+// verdicts on every eval for graphs that repeat with stable topology (decode):
+// the verdicts are a pure function of the backend set (fixed for the lifetime of the
+// scheduler) and of the queried tensor's "support signature". The memos below cache
+// the verdicts keyed on that exact signature, so any change to a field the support
+// queries can read produces a signature mismatch and a full recomputation: the memos
+// are a pure optimization and never a semantic - on any doubt they recompute.
+//
+// The signature captures every tensor field read by the in-tree supports_op
+// implementations (ggml-vulkan.cpp ggml_backend_vk_device_supports_op,
+// ggml-cpu.cpp ggml_backend_cpu_device_supports_op, ggml-cpu amx/repack/kleidiai/
+// spacemit extra buffer types): op, type, ne[], nb[], op_params word 0 for
+// UNARY/GLU/UPSCALE (words 0..3 for SOFT_MAX_BACK; SCALE word 0 is captured too
+// as a defensive superset), flags (not read in-tree, captured anyway), and for
+// each src up to GGML_SCHED_MEMO_MAX_SRCS: type, ne[], nb[], buffer->buft. Ops
+// with more non-NULL srcs than that bypass the memo. supports_buft is a pure
+// function of (device, buft), both immutable for the lifetime of the scheduler.
+//
+// Disable with GGML_SCHED_ASSIGN_MEMO=0 (checked once per scheduler).
+
+#ifndef GGML_SCHED_MEMO_MAX_SRCS
+#define GGML_SCHED_MEMO_MAX_SRCS 3
+#endif
+
+#ifndef GGML_SCHED_MEMO_SB_SLOTS
+#define GGML_SCHED_MEMO_SB_SLOTS 128
+#endif
+
+struct ggml_backend_sched_op_sig_src {
+    int64_t                    ne[GGML_MAX_DIMS];
+    size_t                     nb[GGML_MAX_DIMS];
+    ggml_backend_buffer_type_t buft; // NULL when src->buffer == NULL
+    enum ggml_type             type;
+    int32_t                    pad;
+};
+
+struct ggml_backend_sched_op_sig {
+    int64_t                    ne[GGML_MAX_DIMS];
+    size_t                     nb[GGML_MAX_DIMS];
+    uint32_t                   op_params[4];
+    enum ggml_op               op;
+    enum ggml_type             type;
+    int32_t                    flags;
+    int32_t                    n_src; // number of src[] entries captured (<= GGML_SCHED_MEMO_MAX_SRCS)
+    struct ggml_backend_sched_op_sig_src src[GGML_SCHED_MEMO_MAX_SRCS];
+};
+
+struct ggml_backend_sched_so_memo_slot {
+    bool                             in_use;
+    uint32_t                         hash;   // fast reject before the full signature compare
+    uint32_t                         known;  // bit b set: verdict for backends[b] is cached
+    uint32_t                         val;    // bit b: supports_op(backends[b], sig)
+    struct ggml_backend_sched_op_sig sig;
+};
+
+struct ggml_backend_sched_sb_memo_slot {
+    ggml_backend_buffer_type_t buft;
+    int32_t                    backend_id;
+    bool                       val;
+};
+
 struct ggml_backend_sched_split {
     int backend_id;
     int i_start;
@@ -825,6 +889,17 @@ struct ggml_backend_sched {
     int debug_realloc;
     int debug_graph_size;
     int debug_prev_graph_size;
+
+    // A5-C3 (W6-9): support-verdict memos, see the comment above the memo structs.
+    // 2-way set-associative, so_memo_n is the number of sets (a power of two).
+    struct ggml_backend_sched_so_memo_slot * so_memo; // [2 * so_memo_n]
+    size_t                       so_memo_n;
+    struct ggml_backend_sched_sb_memo_slot * sb_memo;  // [GGML_SCHED_MEMO_SB_SLOTS]
+    bool                         memo_enabled;
+    uint64_t                     memo_so_queries;
+    uint64_t                     memo_so_hits;
+    uint64_t                     memo_sb_queries;
+    uint64_t                     memo_sb_hits;
 };
 
 #define hash_id(tensor) ggml_hash_find_or_insert(&sched->hash_set, tensor)
@@ -832,6 +907,171 @@ struct ggml_backend_sched {
 #define tensor_id_copy(id, backend_id, copy_id) sched->hv_tensor_copies[(id) * sched->n_backends * sched->n_copies + (backend_id) * sched->n_copies + (copy_id)]
 #define tensor_copy(tensor, backend_id, copy_id) tensor_id_copy(hash_id(tensor), backend_id, copy_id)
 
+// ---- A5-C3 (W6-9): support-verdict memos (see the comment above the memo structs) ----
+
+static inline uint32_t ggml_backend_sched_memo_step(uint32_t h, uint64_t w) {
+    h ^= (uint32_t)((w * 0x9E3779B97F4A7C15ull) >> 32);
+    h *= 0x85EBCA6Bu;
+    h ^= h >> 15;
+    return h;
+}
+
+// captures the support signature of `op` into `sig` and computes its hash.
+// returns false when the op has more non-NULL srcs than the memo can store:
+// the caller must then bypass the memo (recompute) - never a wrong answer.
+static bool ggml_backend_sched_op_sig_capture(struct ggml_backend_sched_op_sig * sig, uint32_t * hash, const struct ggml_tensor * op) {
+    memset(sig, 0, sizeof(*sig));
+
+    uint32_t h = 0x12345678u;
+
+    sig->op    = op->op;
+    sig->type  = op->type;
+    sig->flags = op->flags;
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        sig->ne[i] = op->ne[i];
+        sig->nb[i] = op->nb[i];
+    }
+    h = ggml_backend_sched_memo_step(h, (uint64_t) op->op);
+    h = ggml_backend_sched_memo_step(h, (uint64_t) op->type);
+    h = ggml_backend_sched_memo_step(h, (uint32_t) op->flags);
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        h = ggml_backend_sched_memo_step(h, (uint64_t) op->ne[i]);
+        h = ggml_backend_sched_memo_step(h, op->nb[i]);
+    }
+
+    // op_params: only the ops whose supports_op implementations read params are
+    // captured (ggml-vulkan: UNARY/GLU read word 0 via ggml_get_unary_op/
+    // ggml_get_glu_op, UPSCALE reads word 0 mode/antialias bits; ggml-cpu:
+    // SOFT_MAX_BACK reads words 0..1. SCALE is captured too as a defensive
+    // superset even though no in-tree supports_op reads its params). Params are
+    // left out for every other op because ggml does not zero op_params at tensor
+    // creation and unused words may hold stale data.
+    if (op->op == GGML_OP_UNARY || op->op == GGML_OP_GLU || op->op == GGML_OP_UPSCALE || op->op == GGML_OP_SCALE) {
+        sig->op_params[0] = op->op_params[0];
+        h = ggml_backend_sched_memo_step(h, sig->op_params[0]);
+    } else if (op->op == GGML_OP_SOFT_MAX_BACK) {
+        for (int i = 0; i < 4; i++) {
+            sig->op_params[i] = op->op_params[i];
+            h = ggml_backend_sched_memo_step(h, sig->op_params[i]);
+        }
+    }
+
+    int n_src = 0;
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        const struct ggml_tensor * src = op->src[i];
+        if (src == NULL) {
+            continue;
+        }
+        if (n_src == GGML_SCHED_MEMO_MAX_SRCS) {
+            return false; // too many srcs for the memo: bypass
+        }
+        struct ggml_backend_sched_op_sig_src * s = &sig->src[n_src++];
+        s->type = src->type;
+        s->pad  = 0;
+        for (int j = 0; j < GGML_MAX_DIMS; j++) {
+            s->ne[j] = src->ne[j];
+            s->nb[j] = src->nb[j];
+        }
+        s->buft = src->buffer ? src->buffer->buft : NULL;
+        h = ggml_backend_sched_memo_step(h, (uint64_t) src->type);
+        h = ggml_backend_sched_memo_step(h, (uint64_t)(uintptr_t) s->buft);
+        for (int j = 0; j < GGML_MAX_DIMS; j++) {
+            h = ggml_backend_sched_memo_step(h, s->ne[j]);
+            h = ggml_backend_sched_memo_step(h, s->nb[j]);
+        }
+    }
+    sig->n_src = n_src;
+
+    *hash = h ? h : 1;
+    return true;
+}
+
+static inline bool ggml_backend_sched_op_sig_equal(const struct ggml_backend_sched_op_sig * a, const struct ggml_backend_sched_op_sig * b) {
+    return memcmp(a, b, sizeof(*a)) == 0;
+}
+
+// ggml_backend_supports_op() routed through the signature-keyed memo.
+static bool ggml_backend_sched_supports_op(ggml_backend_sched_t sched, int backend_id, const struct ggml_tensor * op) {
+    sched->memo_so_queries++;
+
+    if (!sched->memo_enabled) {
+        return ggml_backend_supports_op(sched->backends[backend_id], op);
+    }
+
+    struct ggml_backend_sched_op_sig sig;
+    uint32_t hash;
+    if (!ggml_backend_sched_op_sig_capture(&sig, &hash, op)) {
+        return ggml_backend_supports_op(sched->backends[backend_id], op);
+    }
+
+    struct ggml_backend_sched_so_memo_slot * base = &sched->so_memo[(hash & (sched->so_memo_n - 1)) * 2];
+    const uint32_t bit = 1u << backend_id;
+
+    for (int i = 0; i < 2; i++) {
+        struct ggml_backend_sched_so_memo_slot * slot = &base[i];
+        if (slot->in_use && slot->hash == hash && (slot->known & bit) &&
+            ggml_backend_sched_op_sig_equal(&slot->sig, &sig)) {
+            sched->memo_so_hits++;
+            return (slot->val & bit) != 0;
+        }
+    }
+
+    const bool val = ggml_backend_supports_op(sched->backends[backend_id], op);
+
+    // fill: prefer an unused slot, else the one already holding this signature,
+    // else the one that cannot answer this query, else the coldest one.
+    // "usable" = unused (fresh fill) or same signature (verdict merge).
+    struct ggml_backend_sched_so_memo_slot * slot = &base[0];
+    const bool usable0 = !slot->in_use || (slot->hash == hash && ggml_backend_sched_op_sig_equal(&slot->sig, &sig));
+    if (!usable0) {
+        const bool usable1 = !base[1].in_use || (base[1].hash == hash && ggml_backend_sched_op_sig_equal(&base[1].sig, &sig));
+        if (usable1) {
+            slot = &base[1];
+        } else if ((slot->known & bit) && !(base[1].known & bit)) {
+            slot = &base[1]; // base[0] can answer this query, base[1] cannot
+        } else if ((slot->known & bit) == (base[1].known & bit) && base[1].known < slot->known) {
+            slot = &base[1]; // neither (or both) can answer: evict the coldest
+        }
+    }
+
+    const bool same_sig = slot->in_use && slot->hash == hash && ggml_backend_sched_op_sig_equal(&slot->sig, &sig);
+    slot->in_use = true;
+    slot->hash   = hash;
+    if (!same_sig) {
+        // fresh signature: drop the verdicts cached for the previous one
+        slot->known = 0;
+        slot->val   = 0;
+        slot->sig   = sig;
+    }
+    slot->known |= bit;
+    slot->val    = (slot->val & ~bit) | (val ? bit : 0u);
+
+    return val;
+}
+
+// ggml_backend_supports_buft() routed through the (buft, backend)-keyed memo.
+static bool ggml_backend_sched_supports_buft(ggml_backend_sched_t sched, int backend_id, ggml_backend_buffer_type_t buft) {
+    sched->memo_sb_queries++;
+
+    if (!sched->memo_enabled) {
+        return ggml_backend_supports_buft(sched->backends[backend_id], buft);
+    }
+
+    struct ggml_backend_sched_sb_memo_slot * slot = &sched->sb_memo[ggml_backend_sched_memo_step(0, (uint64_t)(uintptr_t) buft ^ ((uint64_t)(uint32_t) backend_id << 32)) & (GGML_SCHED_MEMO_SB_SLOTS - 1)];
+
+    if (slot->buft == buft && slot->backend_id == backend_id) {
+        sched->memo_sb_hits++;
+        return slot->val;
+    }
+
+    const bool val = ggml_backend_supports_buft(sched->backends[backend_id], buft);
+    slot->buft      = buft;
+    slot->backend_id = backend_id;
+    slot->val       = val;
+
+    return val;
+}
+
