+                if (sched->bufts[b] == sched->bufts[*node_backend_id] && ggml_backend_sched_supports_op(sched, b, node)) {
                     bool supported = true;
                     for (int j = 0; j < GGML_MAX_SRC; j++) {
                         struct ggml_tensor * src = node->src[j];
@@ -1788,6 +2028,36 @@ ggml_backend_sched_t ggml_backend_sched_new(
     sched->galloc = ggml_gallocr_new_n(sched->bufts, n_backends);
     sched->op_offload = op_offload;
 
+    // A5-C3 (W6-9): support-verdict memos - see the comment above the memo structs.
+    // The memo outlives sched resets on purpose: recurring graphs reuse the verdicts
+    // across evals. GGML_SCHED_ASSIGN_MEMO=0 disables them.
+    const char * GGML_SCHED_ASSIGN_MEMO = getenv("GGML_SCHED_ASSIGN_MEMO");
+    sched->memo_enabled = GGML_SCHED_ASSIGN_MEMO ? atoi(GGML_SCHED_ASSIGN_MEMO) != 0 : true;
+
+    if (sched->memo_enabled) {
+        // one set per graph node, capped (recurring graphs add a handful of shape
+        // variants per node), 2-way set-associative, power-of-two sets. calloc'd
+        // pages are touched lazily, so the cap costs address space, not RSS.
+        size_t so_memo_n = 1;
+        while (so_memo_n < graph_size && so_memo_n < 16384) {
+            so_memo_n <<= 1;
+        }
+
+        sched->so_memo = (struct ggml_backend_sched_so_memo_slot *) calloc(2 * so_memo_n, sizeof(struct ggml_backend_sched_so_memo_slot));
+        sched->so_memo_n = so_memo_n;
+        sched->sb_memo = (struct ggml_backend_sched_sb_memo_slot *) calloc(GGML_SCHED_MEMO_SB_SLOTS, sizeof(struct ggml_backend_sched_sb_memo_slot));
+
+        if (sched->so_memo == NULL || sched->sb_memo == NULL) {
+            // allocation failure must never change behavior
+            free(sched->so_memo);
+            free(sched->sb_memo);
+            sched->so_memo = NULL;
+            sched->sb_memo = NULL;
+            sched->so_memo_n = 0;
+            sched->memo_enabled = false;
+        }
+    }
+
